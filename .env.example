# ============================================================
# Offline RAG Chatbot — environment configuration
# Copy this file to ".env" and adjust values for your machine.
# ============================================================

# --- Security ---
# Generate a real secret with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Database ---
DATABASE_URL=sqlite:///./storage/db.sqlite3

# --- File storage ---
UPLOAD_DIR=./data/uploads
VECTOR_STORE_DIR=./data/vector_store

# --- Embedding model (downloaded once from HuggingFace, then cached locally) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Retrieval ---
TOP_K=3

# --- Text generation provider: "google" (Gemini API) or "ollama" (local) ---
LLM_PROVIDER=google
LLM_TIMEOUT_SECONDS=60

# --- Google Generative AI (Gemini) — used when LLM_PROVIDER=google ---
# Get a key from https://aistudio.google.com/apikey — never commit this value.
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

# --- Local LLM (Ollama) — used when LLM_PROVIDER=ollama ---
# Install Ollama from https://ollama.com, then: ollama pull llama3
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- CORS (frontend origin allowed to call this API) ---
# "*" is fine for an internal ministry LAN demo; restrict in production.
CORS_ORIGINS=*

# --- Default admin account seeded by init_db.py ---
DEFAULT_ADMIN_NAME=IT Officer
DEFAULT_ADMIN_EMAIL=admin@moict.go.ug
DEFAULT_ADMIN_PASSWORD=ChangeMe123!

# --- Default demo staff account seeded by init_db.py ---
DEFAULT_STAFF_NAME=Ministry Staff Demo
DEFAULT_STAFF_EMAIL=staff@moict.go.ug
DEFAULT_STAFF_PASSWORD=StaffDemo123!
